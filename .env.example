# Phase 1 environment — copy to .env and fill in. NEVER commit .env or any secret.
# Read-only scripts (build-circuit, verify) need none of the secrets below.

# Comma-separated X Layer RPC endpoints (first responsive one wins).
RPC_URLS=https://xlayerrpc.okx.com,https://rpc.xlayer.tech

# Deployer private key (0x + 64 hex). REQUIRED only for create-processor / tapeout.
# Fund with ~0.02 OKB on X Layer mainnet before broadcasting (see docs/PHASE1.md).
PRIVATE_KEY=

# Alternative to PRIVATE_KEY (takes precedence if set): BIP-39 seed phrase wallet,
# e.g. OKX Web3 Wallet backup phrase. Prefer MNEMONIC_FILE (path OUTSIDE this repo
# containing only the phrase) over inlining it here. NEVER commit either.
#MNEMONIC=
#MNEMONIC_FILE=C:\Users\USER\.tapeout\mnemonic
# Optional non-standard derivation path (default m/44'/60'/0'/0/0).
#WALLET_DERIVATION_PATH=m/44'/60'/0'/0/0

# Safety gate: broadcasts are refused unless this is exactly 1.
CONFIRM_BROADCAST=0

# Existing processor reuse (skip create-processor): circuits + transistors addresses.
PROCESSOR=
TRANSISTORS=

# Circuit id under test (defaults to state/phase1.json after tapeout).
CIRCUIT_ID=
CREATION_TX=
MINT_TX=
TAPEOUT_TX=

# Processor creation proposal (create-processor only; all have safe defaults).
P1_NAME=Phase1 Proof
P1_SYMBOL=P1PRF
P1_STORY=Minimal Phase 1 proof circuit (2-gate AND). No license terms; REPL test asset.
P1_SUPPLY=100
# 1e12 wei = 0.000001 OKB per material unit.
P1_MINT_PRICE_WEI=1000000000000

# Phase 3 (no secrets here either):
# Public wallet address for dry-run gas estimates (0x + 40 hex; safe to share).
WALLET=
# Deployed AttributionRegistry address once it exists (empty until activation).
REGISTRY=
